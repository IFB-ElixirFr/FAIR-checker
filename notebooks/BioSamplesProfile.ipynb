    "    \"    .\\n\",\n",
    "    \"    {% endfor %}\\n\",\n",
    "    \"\\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"template = Template(shape_tpl)\\n\",\n",
    "    \"\\n\",\n",
    "    \"sample_shape = template.render(\\n\",\n",
    "    \"    target_classes=sample_profile[\\\"target_class\\\"],\\n\",\n",
    "    \"    min_props=sample_profile[\\\"mandatory_properties\\\"],\\n\",\n",
    "    \"    rec_props=sample_profile[\\\"recommended_properties\\\"],\\n\",\n",
    "    \"    opt_props=sample_profile[\\\"optional_properties\\\"],\\n\",\n",
    "    \")\\n\",\n",
    "    \"print(sample_shape)\"\n",
    "   ]\n",
