    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"3da75e78\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Evaluation of SHACL shapes \"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": 111,\n",
    "   \"id\": \"3b6a3cc8\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"from rdflib import Graph, RDF\\n\",\n",
    "    \"from pyshacl import validate\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def validate_shape(knowledge_graph, shacl_shape):\\n\",\n",
    "    \"    r = validate(\\n\",\n",
    "    \"        data_graph=knowledge_graph,\\n\",\n",
    "    \"        data_graph_format=\\\"turtle\\\",\\n\",\n",
    "    \"        shacl_graph=shacl_shape,\\n\",\n",
    "    \"        # shacl_graph = my_shacl_constraint,\\n\",\n",
    "    \"        shacl_graph_format=\\\"turtle\\\",\\n\",\n",
    "    \"        ont_graph=None,\\n\",\n",
    "    \"        inference=\\\"rdfs\\\",\\n\",\n",
    "    \"        abort_on_first=False,\\n\",\n",
    "    \"        meta_shacl=False,\\n\",\n",
    "    \"        debug=False,\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    conforms, results_graph, results_text = r\\n\",\n",
    "    \"\\n\",\n",
    "    \"    report_query = \\\"\\\"\\\"\\n\",\n",
    "    \"            SELECT ?node ?path ?path ?severity WHERE {\\n\",\n",
    "    \"                ?v rdf:type sh:ValidationReport ;\\n\",\n",
    "    \"                   sh:result ?r .\\n\",\n",
    "    \"                ?r sh:focusNode ?node ;\\n\",\n",
    "    \"                   sh:sourceShape ?s .\\n\",\n",
    "    \"                { ?s sh:path ?path ;\\n\",\n",
    "    \"                   sh:severity ?severity . }\\n\",\n",
    "    \"                UNION { ?s sh:path/sh:alternativePath/rdf:rest*/rdf:first ?path ;\\n\",\n",
    "    \"                   sh:severity ?severity . }\\n\",\n",
    "    \"                FILTER (! isBlank(?path))\\n\",\n",
    "    \"            }\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    results = results_graph.query(report_query)\\n\",\n",
    "    \"    print(\\\"VALIDATION RESULTS\\\")\\n\",\n",
    "    \"    print(results_text)\\n\",\n",
    "    \"    # print(conforms)\\n\",\n",
    "    \"    # print(results_graph.serialize(format=\\\"turtle\\\"))\\n\",\n",
    "    \"    warnings = []\\n\",\n",
    "    \"    errors = []\\n\",\n",
    "    \"    infos = []\\n\",\n",
    "    \"    for r in results:\\n\",\n",
    "    \"        if \\\"#Warning\\\" in r[\\\"severity\\\"]:\\n\",\n",
    "    \"            # print(f'WARNING: Property {r[\\\"path\\\"]} should be provided for {r[\\\"node\\\"]}')\\n\",\n",
    "    \"            warnings.append(f'{r[\\\"path\\\"]}')\\n\",\n",
    "    \"        if \\\"#Violation\\\" in r[\\\"severity\\\"]:\\n\",\n",
    "    \"            # print(f'ERROR: Property {r[\\\"path\\\"]} must be provided for {r[\\\"node\\\"]}')\\n\",\n",
    "    \"            errors.append(f'{r[\\\"path\\\"]}')\\n\",\n",
    "    \"        if \\\"#Info\\\" in r[\\\"severity\\\"]:\\n\",\n",
    "    \"            # print(f'INFO: Property {r[\\\"path\\\"]} is recommended for {r[\\\"node\\\"]}')\\n\",\n",
    "    \"            infos.append(f'{r[\\\"path\\\"]}')\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return conforms, infos, warnings, errors\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"c463e711\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Metadata completeness evaluation based on a custom profile\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": 112,\n",
    "   \"id\": \"60604f11\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"def validate_md(graph, profile):\\n\",\n",
    "    \"    # print(f\\\"Validating metadata with the {profile['target_class']} profile...\\\")\\n\",\n",
    "    \"    # print(f\\\"Graph size: {len(graph)} triples\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # print(template.render(\\n\",\n",
    "    \"    #     target_classes=profile[\\\"target_class\\\"],\\n\",\n",
    "    \"    #     min_props=profile[\\\"mandatory_properties\\\"],\\n\",\n",
    "    \"    #     rec_props=profile[\\\"recommended_properties\\\"],\\n\",\n",
    "    \"    #     opt_props=profile[\\\"optional_properties\\\"]\\n\",\n",
    "    \"    # ))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    shape = template.render(\\n\",\n",
    "    \"        target_classes=profile[\\\"target_class\\\"],\\n\",\n",
    "    \"        min_props=profile[\\\"mandatory_properties\\\"],\\n\",\n",
    "    \"        rec_props=profile[\\\"recommended_properties\\\"],\\n\",\n",
    "    \"        opt_props=profile[\\\"optional_properties\\\"],\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    try:\\n\",\n",
    "    \"        shape_kg = Graph()\\n\",\n",
    "    \"        shape_kg.parse(data=shape, format=\\\"turtle\\\")\\n\",\n",
    "    \"        assert len(shape_kg) > 0\\n\",\n",
    "    \"        # print(f\\\"Shape graph size: {len(shape_kg)} triples\\\")\\n\",\n",
    "    \"        # print(shape_kg.serialize(format=\\\"turtle\\\"))\\n\",\n",
    "    \"    except Exception as e:\\n\",\n",
    "    \"        print(\\\"Error parsing the SHACL shape:\\\", e)\\n\",\n",
    "    \"        print(\\\"Shape content was:\\\")\\n\",\n",
    "    \"        print(shape)\\n\",\n",
    "    \"        return\\n\",\n",
    "    \"\\n\",\n",
    "    \"    results = {}\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print()\\n\",\n",
    "    \"    for s, p, o in graph.triples((None, RDF.type, None)):\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # print(f\\\"{s.n3(graph.namespace_manager)} is a {o.n3(graph.namespace_manager)}\\\")\\n\",\n",
    "    \"        # print(f\\\"Profile target classes: {profile['target_class']}\\\")\\n\",\n",
    "    \"        # print(str(o))\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # if o.n3(graph.namespace_manager) in profile[\\\"target_class\\\"]:\\n\",\n",
    "    \"        if str(o) in profile[\\\"target_class\\\"]:\\n\",\n",
    "    \"            print(\\n\",\n",
    "    \"                f\\\"Validating {s} (type: {o}) against profile targeting {profile['target_class']}...\\\"\\n\",\n",
    "    \"            )\\n\",\n",
    "    \"\\n\",\n",
    "    \"            sub_kg = Graph()\\n\",\n",
    "    \"            for x, y, z in graph.triples((s, None, None)):\\n\",\n",
    "    \"                sub_kg.add((x, y, z))\\n\",\n",
    "    \"                for x2, y2, z2 in graph.triples((z, None, None)):\\n\",\n",
    "    \"                    sub_kg.add((x2, y2, z2))\\n\",\n",
    "    \"\\n\",\n",
    "    \"            print(f\\\"Subgraph for {s} has {len(sub_kg)} triples\\\")\\n\",\n",
    "    \"            print(sub_kg.serialize(format=\\\"turtle\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"            conforms, infos, warnings, errors = validate_shape(\\n\",\n",
    "    \"                knowledge_graph=sub_kg, shacl_shape=shape\\n\",\n",
    "    \"            )\\n\",\n",
    "    \"            print(\\n\",\n",
    "    \"                f\\\"Validation result for {s} (type: {o}): conforms={conforms}, infos={infos}, warnings={warnings}, errors={errors}\\\"\\n\",\n",
    "    \"            )\\n\",\n",
    "    \"\\n\",\n",
    "    \"            results[str(s)] = {\\n\",\n",
    "    \"                \\\"type\\\": str(o),\\n\",\n",
    "    \"                \\\"ref_profile\\\": profile[\\\"target_class\\\"],\\n\",\n",
    "    \"                \\\"conforms\\\": conforms,\\n\",\n",
    "    \"                \\\"infos\\\": infos,\\n\",\n",
    "    \"                \\\"warnings\\\": warnings,\\n\",\n",
    "    \"                \\\"errors\\\": errors,\\n\",\n",
    "    \"            }\\n\",\n",
    "    \"\\n\",\n",
    "    \"            print(f\\\"Validation completed for {s}.\\\\n\\\")\\n\",\n",
    "    \"            print(json.dumps(results[str(s)], indent=2))\\n\",\n",
    "    \"\\n\",\n",
    "    \"            n_warnings = len(results[str(s)][\\\"warnings\\\"])\\n\",\n",
    "    \"            n_errors = len(results[str(s)][\\\"errors\\\"])\\n\",\n",
    "    \"            n_infos = len(results[str(s)][\\\"infos\\\"])\\n\",\n",
    "    \"            n_profile_min_props = len(profile[\\\"mandatory_properties\\\"])\\n\",\n",
    "    \"            n_profile_rec_props = len(profile[\\\"recommended_properties\\\"])\\n\",\n",
    "    \"            n_profile_opt_props = len(profile[\\\"optional_properties\\\"])\\n\",\n",
    "    \"\\n\",\n",
    "    \"            completeness_score = round(\\n\",\n",
    "    \"                (\\n\",\n",
    "    \"                    3 * (n_profile_min_props - n_errors)\\n\",\n",
    "    \"                    + 2 * (n_profile_rec_props - n_warnings)\\n\",\n",
    "    \"                    + 1 * (n_profile_opt_props - n_infos)\\n\",\n",
    "    \"                )\\n\",\n",
    "    \"                * 100\\n\",\n",
    "    \"                / (\\n\",\n",
    "    \"                    3 * (n_profile_min_props)\\n\",\n",
    "    \"                    + 2 * (n_profile_rec_props)\\n\",\n",
    "    \"                    + 1 * (n_profile_opt_props)\\n\",\n",
    "    \"                ),\\n\",\n",
    "    \"                2,\\n\",\n",
    "    \"            )\\n\",\n",
    "    \"\\n\",\n",
    "    \"            results[str(s)][\\\"completeness_score\\\"] = completeness_score\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return results\"\n",
    "   ]\n",
    "  },\n",
