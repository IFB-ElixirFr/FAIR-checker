<https://workflowhub.eu/workflows/673?version=1> a ns1:ComputationalWorkflow,
        ns1:SoftwareSourceCode ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE/" ;
    ns1:creator <#The%20Workflows%20and%20Distributed%20Computing%20Team%20(https://www.bsc.es/discover-bsc/organisation/scientific-structure/workflows-and-distributed-computing/)>,
        <https://workflowhub.eu/people/592> ;
    ns1:dateCreated "2023-11-16T14:27:39Z"^^ns1:Date ;
    ns1:dateModified "2023-11-16T14:29:36Z"^^ns1:Date ;
    ns1:description """**Contact Person:** support-compss@bsc.es  \r
**Access Level:** public  \r
**License Agreement:** Apache2  \r
**Platform:** COMPSs  \r
\r
# Description\r
\r
Simple is an application that takes one value and increases it by five units. The purpose of this application is to show how tasks are managed by COMPSs.\r
\r
# Execution instructions\r
Usage:\r
```\r
runcompss --lang=python src/simple.py initValue\r
```\r
\r
where:\r
* initValue: Initial value for counter\r
\r
# Execution Examples\r
```\r
runcompss --lang=python src/simple.py 1\r
runcompss src/simple.py 1\r
python -m pycompss src/simple.py 1\r
```\r
\r
# Build\r
No build is required\r
""" ;
    ns1:image <https://workflowhub.eu/workflows/883/diagram?version=1> ;
    ns1:keywords "PyCOMPSs, Example, Tutorial, Laptop" ;
    ns1:license <https://spdx.org/licenses/Apache-2.0> ;
    ns1:name "PyCOMPSs simple example (ran on macOS laptop, input generated by the code, INOUT file example)" ;
    ns1:producer <https://workflowhub.eu/projects/172> ;
    ns1:programmingLanguage <https://workflowhub.eu/workflows/673#pycompss> ;
    ns1:sdPublisher <https://about.workflowhub.eu/> ;
