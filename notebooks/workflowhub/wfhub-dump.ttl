        <https://workflowhub.eu/workflows/527#cwl_based__single_sample__workflow_for_germline_variant_calling-inputs-bcftools_view_include_hard_filters>,
        <https://workflowhub.eu/workflows/527#cwl_based__single_sample__workflow_for_germline_variant_calling-inputs-bcftools_view_threads>,
