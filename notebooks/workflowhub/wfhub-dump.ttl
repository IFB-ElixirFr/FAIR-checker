    ns1:dateModified "2024-03-13T09:53:44Z"^^ns1:Date ;
    ns1:description "The workflow takes a trimmed HiFi reads collection, Hap1/Hap2 contigs, and the values for transition parameter and max coverage depth (calculated from WF1) to run Purge_Dups. It produces purged Hap1 and Hap2 contigs assemblies, and runs all the QC analysis (gfastats, BUSCO, and Merqury)." ;
    ns1:image <https://workflowhub.eu/workflows/938/diagram?version=2> ;
    ns1:isBasedOn <https://workflowhub.eu/workflows/606?version=1> ;
    ns1:isPartOf <https://workflowhub.eu/collections/10> ;
    ns1:keywords "ERGA, Assembly+QC, HiFi" ;
    ns1:license <https://spdx.org/licenses/MIT> ;
    ns1:name "ERGA HiFi Hap1Hap2 Purge+QC v2309 (WF3)" ;
