<https://workflowhub.eu/workflows/816?version=1> a ns1:ComputationalWorkflow,
        ns1:SoftwareSourceCode ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE/" ;
    ns1:creator <https://orcid.org/0009-0007-1637-4487>,
        <https://workflowhub.eu/people/715>,
