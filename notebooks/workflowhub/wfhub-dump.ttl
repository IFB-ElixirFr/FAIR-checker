[] a ns1:LearningResource ;
    dcterms:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    ns1:about <http://edamontology.org/topic_0091>,
        <http://edamontology.org/topic_3474>,
        <http://edamontology.org/topic_4019> ;
    ns1:audience [ a ns1:Audience ;
            ns1:audienceType "machine learning enthusiasts" ] ;
    ns1:author [ a ns1:Person ;
            ns1:name "Fotis Psomopoulos" ],
        [ a ns1:Person ;
            ns1:name "Silvio Tossato" ],
        [ a ns1:Person ;
            ns1:name "Jennifer Harrow" ],
        [ a ns1:Person ;
            ns1:name "Leyla Jael Castro" ] ;
    ns1:dateCreated "2020-12-19"^^ns1:Date ;
    ns1:description "In this lesson we will introduce the subject of good practices via the DOME recommendations when sharing supervised machine learning approaches with peers" ;
    ns1:educationalLevel "beginner" ;
    ns1:inLanguage "en" ;
    ns1:keywords "Machine learning, supervised learning, good practices, ML sharing, ML comparison" ;
    ns1:learningResourceType "presentation" ;
    ns1:license <https://creativecommons.org/licenses/by/4.0/> ;
    ns1:name "DOME recommendations using a Galaxy tutorial as a use case" ;
    ns1:teaches "Applying the DOME recommendations to your own supervised machine learning approach (or at least the provided use case)",
        "Listing some key elements to improve sharing and enabling comparison of supervised machine learning approaches",
        "Understanding the DOME recommendations",
        "Understanding what information is key when sharing supervised machine learning approaches" ;
    ns1:version "1.0" .

