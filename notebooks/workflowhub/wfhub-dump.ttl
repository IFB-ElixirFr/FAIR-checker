    ns1:isPartOf <https://workflowhub.eu/collections/6> ;
    ns1:keywords "Genomics, Alignment, BROAD, WGS, BWA-mem, scalable, NCI, Gadi, PBS, genome, DNA, mapping" ;
    ns1:license <https://spdx.org/licenses/GPL-3.0> ;
    ns1:name "Fastq-to-bam @ NCI-Gadi" ;
