<https://workflowhub.eu/documents/11?version=1> a ns1:DigitalDocument ;
    dcterms:conformsTo "https://schema.org/DigitalDocument" ;
    ns1:creator <https://workflowhub.eu/people/144> ;
    ns1:dateCreated "2022-07-12T10:08:21Z"^^ns1:Date ;
    ns1:dateModified "2022-07-12T10:08:21Z"^^ns1:Date ;
    ns1:description "" ;
