    ns1:description "This is a Galaxy workflow for performing molecular dynamics simulations and analysis with flavivirus helicases in the Apo or unbound state. The associated input files can be found at: https://zenodo.org/records/7493015 The associated output files can be found at: https://zenodo.org/records/7850935" ;
    ns1:input <https://workflowhub.eu/workflows/762#flavivirushelicase_apo-inputs-%23main/protein%20pdb%20file> ;
    ns1:keywords "zika, dengue, west nile, helicase, rna virus, molecular dynamics" ;
    ns1:license <https://spdx.org/licenses/CC-BY-4.0> ;
    ns1:name "flavivirushelicase_apo" ;
