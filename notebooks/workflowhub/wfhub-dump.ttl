<https://workflowhub.eu/collections/9> a ns1:Collection ;
    dcterms:conformsTo "https://schema.org/Collection" ;
    ns1:creator <https://workflowhub.eu/people/462> ;
    ns1:dateCreated "2023-05-05T06:31:30Z"^^ns1:Date ;
    ns1:dateModified "2023-11-09T05:41:31Z"^^ns1:Date ;
    ns1:description """This collection houses some scanpy-based scRNAseq workflows on galaxy Australia.\r
\r
The aim of these workflows is to handle the routine ‘boring’ part of single cell RNAseq data processing. It will produces an ‘AnnData’ object, which can then be used as a base for downstream analysis – either within galaxy or outside of it. AnnData is a standard format used by the ‘scanpy’ python package.\r
\r
These workflows represent just one way of processing data for a ‘typical’ scRNAseq experiment – there are many other options!\r
\r
The how-to guide is available here:https://github.com/swbioinf/scrnaseq_howto_ga_workflows\r
\r
These workflows are based on the 'Clustering 3K PBMCs with Scanpy' tutorial  (Bérénice Batut, Hans-Rudolf Hotz, Mehmet Tekman) https://training.galaxyproject.org/training-material/topics/single-cell/tutorials/scrna-scanpy-pbmc3k/tutorial.html.""" ;
    ns1:hasPart <https://workflowhub.eu/workflows/465>,
        <https://workflowhub.eu/workflows/467>,
        <https://workflowhub.eu/workflows/468>,
        <https://workflowhub.eu/workflows/512>,
        <https://workflowhub.eu/workflows/513>,
        <https://workflowhub.eu/workflows/514>,
        <https://workflowhub.eu/workflows/646>,
        <https://workflowhub.eu/workflows/647> ;
    ns1:keywords "" ;
    ns1:license <https://spdx.org/licenses/CC-BY-4.0> ;
    ns1:name "scRNAseq processing in galaxy" ;
    ns1:producer <https://workflowhub.eu/projects/41> ;
    ns1:url <https://workflowhub.eu/collections/9> .

