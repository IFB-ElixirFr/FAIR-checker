    ns1:isPartOf <https://workflowhub.eu/collections/21> ;
    ns1:keywords "Assembly, Genomics, Snakemake, Bioinformatics, Genome assembly" ;
    ns1:license <https://spdx.org/licenses/CC-BY-4.0> ;
    ns1:name "Purge retained haplotypes using Purge-Dups" ;
