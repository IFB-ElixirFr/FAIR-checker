    ns1:producer <https://workflowhub.eu/projects/94> ;
    ns1:programmingLanguage <https://workflowhub.eu/workflows/387#knime>,
        <https://www.bfs.admin.ch/asset/de/ts-x-04.02.01.02#knime> ;
    ns1:sdPublisher <https://about.workflowhub.eu/> ;
