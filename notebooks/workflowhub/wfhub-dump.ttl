<https://workflowhub.eu/projects/204> a ns1:Organization,
        ns1:Project ;
    ns2:description "Training materials about the DOME recommendations with a Galazy tutorial as a use case" ;
    ns2:locale "en_US" ;
    ns2:site_name "DOME recommendations with a Galaxy tutorial as a use case" ;
    ns2:title "Introduction" ;
    ns2:type "website" ;
    ns2:url "https://zbmed-semtec.github.io/dome-galaxy-training/docs/DOME.html" ;
    dcterms:conformsTo "https://schema.org/Project" ;
    ns1:description """We gather the high throughput sequence data as it is generated, run quality control analysis to make sure the data is good quality and from the expected species.\r
We assemble the long read sequence data into long contiguous pieces, then use further long-range sequencing data to scaffold the data into chromosome scale blocks.\r
We then manually curate the assembly and submit it to INSDC.\r
\r
We also develop automated tools and pipelines to enable the high throughput required for ever growing number of genomes being sequenced.""" ;
    ns1:funder <https://workflowhub.eu/programmes/37> ;
    ns1:keywords "" ;
    ns1:member <https://workflowhub.eu/institutions/182>,
        <https://workflowhub.eu/people/567>,
