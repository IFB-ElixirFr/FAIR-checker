<https://workflowhub.eu/projects/141> a ns1:Organization,
        ns1:Project ;
    dcterms:conformsTo "https://schema.org/Project" ;
    ns1:description "We are a computational research lab located at the Department of Genetics, Microbiology and Statistics of the University of Barcelona (UB). Our main interest is the interplay between genetic variation, gene expression and complex traits. We study the effects of genetic variants in molecular (both bulk and single cell transcriptome, epigenome, etc.) and organismic phenotypes at a population level, and their impact on health and disease. We have expertise in the development of novel statistical methods and automated pipelines for the analysis of transcriptomic data and Genome-Wide Association Studies (GWAS)." ;
    ns1:funder <https://workflowhub.eu/programmes/3> ;
    ns1:keywords "" ;
    ns1:member <https://workflowhub.eu/institutions/127>,
        <https://workflowhub.eu/people/403> ;
    ns1:name "Statistical genetics" ;
    ns1:url <https://workflowhub.eu/projects/141> .

<https://workflowhub.eu/projects/146> a ns1:Organization,
        ns1:Project ;
    dcterms:conformsTo "https://schema.org/Project" ;
    ns1:description "The Computational Earth Sciences (CES) group is a multidisciplinary team with different technical profiles that closely relates to all the other groups in the department. CES supports scientists in their daily work and provides a framework for the most efficient use of IT resources, specializing in HPC. At the same time, the group has different research lines related to profiling and optimization and porting Earth modeling codes toward Exascale computing. The group has links and collaborations established with other groups and departments at the BSC and the European Earth modeling community. For example, it leads the Center of Excellence for Weather and Climate phase 3 (ESiWACE3) and participates in different Digital Twin initiatives, such as Destination Earth and Digital Twin Ocean." ;
    ns1:funder <https://workflowhub.eu/programmes/3> ;
    ns1:keywords "" ;
    ns1:member <https://workflowhub.eu/institutions/5>,
        <https://workflowhub.eu/people/407>,
        <https://workflowhub.eu/people/598> ;
    ns1:name "BSC-CES" ;
    ns1:url <https://www.bsc.es/discover-bsc/organisation/scientific-structure/computational-earth-sciences> .

