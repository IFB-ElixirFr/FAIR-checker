<https://workflowhub.eu/workflows/607?version=1> a ns1:ComputationalWorkflow,
        ns1:SoftwareSourceCode ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE/" ;
    ns1:creator <https://workflowhub.eu/workflows/607#Wolfgang%20Maier> ;
    ns1:dateCreated "2023-10-10T16:08:59Z"^^ns1:Date ;
    ns1:dateModified "2023-10-27T13:42:31Z"^^ns1:Date ;
    ns1:description """This Galaxy workflow takes a list of tumor/normal sample pair variants in VCF format and\r
1. annotates them using the ENSEMBL Variant Effect Predictor and custom annotation data\r
2. turns the annotated VCF into a MAF file for import into cBioPortal\r
3. generates human-readable variant- and gene-centric reports\r
\r
The input VCF is expected to encode somatic status, somatic p-value and germline p-value of each variant in varscan somatic format, i.e., via SS, SPV and GPV INFO keys, respectively.""" ;
    ns1:input <https://workflowhub.eu/workflows/607#cancer_variant_annotation__hg38_vep_based_-inputs-Annotations%20data>,
        <https://workflowhub.eu/workflows/607#cancer_variant_annotation__hg38_vep_based_-inputs-Report%20germline%20variants?>,
        <https://workflowhub.eu/workflows/607#cancer_variant_annotation__hg38_vep_based_-inputs-Variants%20to%20be%20annotated> ;
    ns1:keywords "EOSC4Cancer" ;
    ns1:license <https://spdx.org/licenses/MIT> ;
    ns1:name "Cancer variant annotation (hg38 VEP-based)" ;
    ns1:output <https://workflowhub.eu/workflows/607#cancer_variant_annotation__hg38_vep_based_-outputs-annotation_metadata>,
        <https://workflowhub.eu/workflows/607#cancer_variant_annotation__hg38_vep_based_-outputs-cancer_hotspots>,
        <https://workflowhub.eu/workflows/607#cancer_variant_annotation__hg38_vep_based_-outputs-cgi_biomarkers>,
        <https://workflowhub.eu/workflows/607#cancer_variant_annotation__hg38_vep_based_-outputs-cgi_genes>,
        <https://workflowhub.eu/workflows/607#cancer_variant_annotation__hg38_vep_based_-outputs-civic_genes>,
        <https://workflowhub.eu/workflows/607#cancer_variant_annotation__hg38_vep_based_-outputs-civic_variants>,
        <https://workflowhub.eu/workflows/607#cancer_variant_annotation__hg38_vep_based_-outputs-dbsnp_vcf>,
        <https://workflowhub.eu/workflows/607#cancer_variant_annotation__hg38_vep_based_-outputs-final_variants>,
        <https://workflowhub.eu/workflows/607#cancer_variant_annotation__hg38_vep_based_-outputs-gene_cards_germline>,
        <https://workflowhub.eu/workflows/607#cancer_variant_annotation__hg38_vep_based_-outputs-gene_cards_loh>,
