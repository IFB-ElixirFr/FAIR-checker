        <https://workflowhub.eu/workflows/372#metagenomic_gems_from_assembly-inputs-threads> ;
    ns1:keywords "Metagenomics, Genomics, GEM, carveme, memote" ;
    ns1:license <https://spdx.org/licenses/Apache-2.0> ;
    ns1:name "Metagenomic GEMs from Assembly" ;
    ns1:output <https://workflowhub.eu/workflows/372#metagenomic_gems_from_assembly-outputs-carveme_gems_folder>,
