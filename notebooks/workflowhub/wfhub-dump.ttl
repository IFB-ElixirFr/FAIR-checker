<https://workflowhub.eu/workflows/140?version=1> a ns1:ComputationalWorkflow,
        ns1:SoftwareSourceCode ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE/" ;
    ns1:creator <https://workflowhub.eu/people/140>,
        <https://workflowhub.eu/workflows/140#%C2%A0Brian%20M%20Forde>,
        <https://workflowhub.eu/workflows/140#Adam%20D%20Irwin>,
