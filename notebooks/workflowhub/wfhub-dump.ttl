<https://workflowhub.eu/workflows/110?version=9> a ns1:ComputationalWorkflow,
        ns1:SoftwareSourceCode ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE/" ;
    ns1:creator <https://workflowhub.eu/people/222> ;
    ns1:dateCreated "2024-03-07T03:02:34Z"^^ns1:Date ;
    ns1:dateModified "2024-06-13T01:01:42Z"^^ns1:Date ;
    ns1:description """COVID-19: variation analysis on ARTIC PE data\r
---------------------------------------------\r
\r
The workflow for Illumina-sequenced ampliconic data builds on the RNASeq workflow\r
for paired-end data using the same steps for mapping and variant calling, but\r
adds extra logic for trimming amplicon primer sequences off reads with the ivar\r
package. In addition, this workflow uses ivar also to identify amplicons\r
affected by primer-binding site mutations and, if possible, excludes reads\r
derived from such "tainted" amplicons when calculating allele-frequencies\r
of other variants.\r
""" ;
    ns1:input <https://workflowhub.eu/workflows/110#sars_cov_2_pe_illumina_artic_variant_calling_covid_19_pe_artic_illumina-inputs-ARTIC%20primer%20BED>,
        <https://workflowhub.eu/workflows/110#sars_cov_2_pe_illumina_artic_variant_calling_covid_19_pe_artic_illumina-inputs-ARTIC%20primers%20to%20amplicon%20assignments>,
        <https://workflowhub.eu/workflows/110#sars_cov_2_pe_illumina_artic_variant_calling_covid_19_pe_artic_illumina-inputs-Minimum%20DP%20required%20after%20amplicon%20bias%20correction>,
        <https://workflowhub.eu/workflows/110#sars_cov_2_pe_illumina_artic_variant_calling_covid_19_pe_artic_illumina-inputs-Minimum%20DP_ALT%20required%20after%20amplicon%20bias%20correction>,
        <https://workflowhub.eu/workflows/110#sars_cov_2_pe_illumina_artic_variant_calling_covid_19_pe_artic_illumina-inputs-NC_045512.2%20FASTA%20sequence%20of%20SARS-CoV-2>,
        <https://workflowhub.eu/workflows/110#sars_cov_2_pe_illumina_artic_variant_calling_covid_19_pe_artic_illumina-inputs-Paired%20Collection>,
        <https://workflowhub.eu/workflows/110#sars_cov_2_pe_illumina_artic_variant_calling_covid_19_pe_artic_illumina-inputs-Read%20removal%20maximum%20AF>,
