<https://workflowhub.eu/workflows/897?version=1> a ns1:ComputationalWorkflow,
        ns1:SoftwareSourceCode ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE/" ;
    ns1:creator <https://workflowhub.eu/people/747>,
        <https://workflowhub.eu/people/752>,
        <https://workflowhub.eu/people/753>,
        <https://workflowhub.eu/workflows/897#RECETOX%20SpecDat> ;
    ns1:dateCreated "2024-06-03T13:52:34Z"^^ns1:Date ;
    ns1:dateModified "2024-06-06T10:42:41Z"^^ns1:Date ;
    ns1:description """# Galaxy Workflow Documentation: In-Silico Mass Spectra Prediction Using Semi-Empirical Quantum Chemistry\r
\r
\r
## Overview\r
\r
This workflow predicts in-silico mass spectra using a semi-empirical quantum chemistry method. It involves generating and optimizing molecular conformers and simulating their mass spectra with computational chemistry tools. The workflow receives an SDF file as input and outputs the mass spectrum in MSP file format.\r
\r
\r
\r
\r
\r
""" ;
    ns1:image <https://workflowhub.eu/workflows/1231/diagram?version=1> ;
    ns1:input <https://workflowhub.eu/workflows/897#end_to_end_spectra_predictions__multi_atoms_dataset-inputs-%23main/List%20of%20molecules>,
        <https://workflowhub.eu/workflows/897#end_to_end_spectra_predictions__multi_atoms_dataset-inputs-%23main/Number%20of%20conformers%20to%20generate>,
        <https://workflowhub.eu/workflows/897#end_to_end_spectra_predictions__multi_atoms_dataset-inputs-%23main/Optimization%20Levels>,
        <https://workflowhub.eu/workflows/897#end_to_end_spectra_predictions__multi_atoms_dataset-inputs-%23main/QC%20Method> ;
    ns1:keywords "Exposomics, QCxMS, GC-MS, Metabolomics" ;
    ns1:license <https://spdx.org/licenses/MIT> ;
    ns1:name "End-to-end spectra predictions: multi atoms dataset" ;
    ns1:output <https://workflowhub.eu/workflows/897#end_to_end_spectra_predictions__multi_atoms_dataset-outputs-%23main/%5B.in%5D%20output>,
        <https://workflowhub.eu/workflows/897#end_to_end_spectra_predictions__multi_atoms_dataset-outputs-%23main/%5B.start%5D%20output>,
