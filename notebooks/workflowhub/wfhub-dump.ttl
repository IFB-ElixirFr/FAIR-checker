<https://workflowhub.eu/projects/195> a ns1:Organization,
        ns1:Project ;
    dcterms:conformsTo "https://schema.org/Project" ;
    ns1:description "Machine Learning Made Easy (MLme) is a novel tool that simplifies machine learning (ML) for researchers. By integrating four essential functionalities, namely data exploration, AutoML, CustomML, and visualization, MLme fulfills the diverse requirements of researchers while eliminating the need for extensive coding efforts. MLme serves as a valuable resource that empowers researchers of all technical levels to leverage ML for insightful data analysis and enhance research outcomes. By simplifying and automating various stages of the ML workflow, it enables researchers to allocate more time to their core research tasks, thereby enhancing efficiency and productivity." ;
    ns1:funder <https://workflowhub.eu/programmes/3> ;
    ns1:keywords "" ;
    ns1:member <https://workflowhub.eu/institutions/175>,
        <https://workflowhub.eu/people/560> ;
    ns1:name "MLme: Machine Learning Made Easy" ;
    ns1:url <https://github.com/FunctionalUrology/MLme> .

