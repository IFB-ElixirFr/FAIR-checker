    ns1:name "Life Science cross-RI (Research Infrastructure) project" ;
    ns1:producer <https://workflowhub.eu/projects/169> ;
    ns1:programmingLanguage <https://workflowhub.eu/workflows/516#jupyter> ;
    ns1:sdPublisher <https://about.workflowhub.eu/> ;
    ns1:url <https://workflowhub.eu/workflows/516?version=1> ;
    ns1:version 1 .

