<https://workflowhub.eu/workflows/605?version=1> a ns1:ComputationalWorkflow,
        ns1:SoftwareSourceCode ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE/" ;
    ns1:creator <https://workflowhub.eu/people/445>,
        <https://workflowhub.eu/workflows/605#ERGA> ;
    ns1:dateCreated "2023-10-09T12:47:49Z"^^ns1:Date ;
    ns1:dateModified "2024-03-13T09:52:13Z"^^ns1:Date ;
    ns1:description "The workflow takes a trimmed HiFi reads collection, Forward/Reverse HiC reads, and the max coverage depth (calculated from WF1) to run Hifiasm in HiC phasing mode. It produces both Pri/Alt and Hap1/Hap2 assemblies, and runs all the QC analysis (gfastats, BUSCO, and Merqury). The default Hifiasm purge level is Light (l1)." ;
    ns1:image <https://workflowhub.eu/workflows/783/diagram?version=1> ;
    ns1:input <https://workflowhub.eu/workflows/605#erga_hifi_hic_assembly_qc_hifiasm_v2309__wf2_-inputs-%23main/Estimated%20genome%20size>,
