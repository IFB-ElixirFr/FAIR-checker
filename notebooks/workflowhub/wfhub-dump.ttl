    ns1:license <https://spdx.org/licenses/GPL-3.0> ;
    ns1:name "Repeat masking - TSI" ;
    ns1:output <https://workflowhub.eu/workflows/875#repeat_masking___tsi-outputs-%23main/Repeats_output_table>,
