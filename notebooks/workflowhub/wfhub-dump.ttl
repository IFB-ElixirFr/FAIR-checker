<https://workflowhub.eu/projects/71> a ns1:Organization,
        ns1:Project ;
    ns2:image "https://dam-api.bfs.admin.ch/hub/api/dam/assets/24485120/thumbnail?width=1024&height=512" ;
    ns2:site_name "Bundesamt für Statistik" ;
    ns2:title "Wohnverhältnisse nach Bewohnertyp und Bezirk, 2019-2021 kumuliert - 2019-2021 | Tabelle  | Bundesamt für Statistik" ;
    ns2:type "article" ;
    ns2:url "https://www.bfs.admin.ch/asset/de/24485120" ;
    ns3:published_time "2023-03-23T07:30:00Z" ;
    ns4:admins "" ;
    dcterms:conformsTo "https://schema.org/Project" ;
    ns1:description """OpenEBench (https://openebench.bsc.es) is the ELIXIR benchmarking and technical monitoring platform for bioinformatics tools, web servers, and workflows. OpenEBench is part of the ELIXIR Tools platform and its development is led by the Barcelona Supercomputing Center (BSC) in collaboration with partners within ELIXIR and beyond.\r
\r
Within the ELIXIR project, OpenEBench is being developed under the Tools Platform at the Work Package 2 (WP2: Benchmarking) (https://elixir-europe.org/platforms/tools).\r
\r
All OpenEBench components have been designed and implemented following the recommendations made by the ELIXIR tools platform e.g. making code available in public repositories from day 1; are available as software containers, and using workflow managers promoted by ELIXIR. The next figure illustrates the interconnection of OpenEBench to other ELIXIR tools platforms systems and platforms and beyond.\r
\r
For more information go to: https://openebench.readthedocs.io/en/latest/""" ;
    ns1:funder <https://workflowhub.eu/programmes/3> ;
    ns1:image <https://workflowhub.eu/projects/71/avatars/113?size=250> ;
