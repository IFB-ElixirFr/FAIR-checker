    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE/" ;
    ns1:creator <https://workflowhub.eu/workflows/18#Bj%C3%B6rn%20Gr%C3%BCning>,
        <https://workflowhub.eu/workflows/18#Frank%20von%20Delft>,
