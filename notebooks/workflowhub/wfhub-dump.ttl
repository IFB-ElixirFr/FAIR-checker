        <https://workflowhub.eu/workflows/356#generic_consensus_construction_from_vcf_calls-inputs-min-AF%20for%20consensus%20variant>,
        <https://workflowhub.eu/workflows/356#generic_consensus_construction_from_vcf_calls-inputs-min-AF%20for%20failed%20variants> ;
    ns1:keywords "mlxv, generic" ;
    ns1:license <https://spdx.org/licenses/CC-BY-4.0> ;
    ns1:name "Generic consensus construction from VCF calls" ;
    ns1:output <https://workflowhub.eu/workflows/356#generic_consensus_construction_from_vcf_calls-outputs-1_based_masking_regions>,
        <https://workflowhub.eu/workflows/356#generic_consensus_construction_from_vcf_calls-outputs-called_variant_sites>,
