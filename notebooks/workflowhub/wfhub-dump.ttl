        <https://workflowhub.eu/people/605>,
        <https://workflowhub.eu/people/712> ;
    ns1:name "Tree of Life Genome Assembly" ;
    ns1:url <https://workflowhub.eu/projects/204> ;
    ns5:title "Introduction" .

