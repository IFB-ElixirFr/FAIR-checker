<https://workflowhub.eu/projects/210> a ns1:Organization,
        ns1:Project ;
    ns2:image "https://dam-api.bfs.admin.ch/hub/api/dam/assets/25425195/thumbnail?width=1024&height=512" ;
    ns2:site_name "Bundesamt für Statistik" ;
    ns2:title "Anzahl und Anteil der Beziehenden in den 24 Monaten vor Austritt aus der Arbeitslosenversicherung (ALV), der Invalidenversicherung (IV) oder der Sozialhilfe (SH), nach Monat und Situation - 2012-2020 | Tabelle  | Bundesamt für Statistik" ;
