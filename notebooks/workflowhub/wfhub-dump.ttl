    ns1:description "This is a Galaxy workflow for performing molecular dynamics simulations and analysis with coronavirus helicases in the Apo or unbound state. The associated input files can be found at: https://zenodo.org/records/7492987. The associated output files can be found at: https://zenodo.org/records/7851000." ;
    ns1:input <https://workflowhub.eu/workflows/764#coronavirushelicase_apo-inputs-%23main/protein%20pdb%20file>,
        <https://workflowhub.eu/workflows/764#coronavirushelicase_apo-inputs-%23main/specialized%20FF%20frcmod%20file>,
        <https://workflowhub.eu/workflows/764#coronavirushelicase_apo-inputs-%23main/specialized%20FF%20prep%20file> ;
    ns1:keywords "covid-19, SARS-CoV-2, covid19.galaxyproject.org, NSP13, helicase, coronavirus, rna virus, MERS, molecular dynamics" ;
