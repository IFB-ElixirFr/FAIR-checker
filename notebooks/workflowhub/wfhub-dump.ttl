<https://workflowhub.eu/workflows/603?version=1> a ns1:ComputationalWorkflow,
        ns1:SoftwareSourceCode ;
    dcterms:conformsTo "https://bioschemas.org/profiles/ComputationalWorkflow/1.0-RELEASE/" ;
    ns1:creator <https://workflowhub.eu/people/445>,
        <https://workflowhub.eu/workflows/603#ERGA> ;
    ns1:dateCreated "2023-10-06T13:25:56Z"^^ns1:Date ;
    ns1:dateModified "2024-03-13T09:07:03Z"^^ns1:Date ;
    ns1:description "The workflow takes a trimmed HiFi reads collection, runs Meryl to create a K-mer database, Genomescope2 to estimate genome properties and Smudgeplot to estimate ploidy. The main results are K-mer database and genome profiling plots, tables, and values useful for downstream analysis. Default K-mer length and ploidy for Genomescope are 21 and 2, respectively. " ;
    ns1:image <https://workflowhub.eu/workflows/781/diagram?version=1> ;
    ns1:input <https://workflowhub.eu/workflows/603#erga_profiling_hifi_v2309__wf1_-inputs-%23main/Ploidy>,
        <https://workflowhub.eu/workflows/603#erga_profiling_hifi_v2309__wf1_-inputs-%23main/Trimmed%20HiFi%20collection>,
        <https://workflowhub.eu/workflows/603#erga_profiling_hifi_v2309__wf1_-inputs-%23main/kmer%20length> ;
    ns1:isPartOf <https://workflowhub.eu/collections/10> ;
    ns1:keywords "ERGA, Profiling, HiFi" ;
    ns1:license <https://spdx.org/licenses/MIT> ;
    ns1:name "ERGA Profiling HiFi v2309 (WF1)" ;
