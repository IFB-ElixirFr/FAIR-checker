<https://workflowhub.eu/programmes/1> a ns1:FundingScheme ;
    ns2:image "https://dam-api.bfs.admin.ch/hub/api/dam/assets/23225665/thumbnail?width=1024&height=512" ;
    ns2:site_name "Bundesamt für Statistik" ;
    ns2:title "Häusliche Gewalt: Polizeilich registrierte Gewaltstraftaten nach Beziehung - 2009-2021 | Tabelle  | Bundesamt für Statistik" ;
    ns2:type "article" ;
